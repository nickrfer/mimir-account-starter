# Referência sem segredos; gere os arquivos locais com pnpm setup.
MIMIR_CONFIG_DIR=.
MIMIR_HTTP_PORT=3000
# Desenvolvimento opcional em contêiner.
MIMIR_VITE_PORT=5173
MIMIR_WATCH_POLLING=true
# Origens exatas do navegador; ajustar se mudar portas. Exceção HTTP somente local.
MIMIR_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
MIMIR_ALLOW_LOCAL_HTTP=true
