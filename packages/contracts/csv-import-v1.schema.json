{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "mimir.csv.import.v1"
    },
    "accountId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "periodMonth": {
      "type": "string",
      "pattern": "^(19[0-9]{2}|[2-9][0-9]{3})-(0[1-9]|1[0-2])$"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "occurred_on": {
            "type": "string",
            "format": "date",
            "pattern": "^(19[0-9]{2}|[2-9][0-9]{3})-[0-9]{2}-[0-9]{2}$"
          },
          "direction": {
            "type": "string",
            "enum": [
              "ENTRADA",
              "SAIDA"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99999999999
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "classification": {
            "type": "string",
            "enum": [
              "RECEITA",
              "DESPESA",
              "TRANSFERENCIA",
              "A_ESCLARECER"
            ]
          },
          "is_pf_business_expense": {
            "type": "boolean"
          },
          "explanation": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "external_id",
          "occurred_on",
          "direction",
          "amount_cents",
          "description",
          "category",
          "classification",
          "is_pf_business_expense",
          "explanation"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "schemaVersion",
    "accountId",
    "sourceCode",
    "periodMonth",
    "rows"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linhas normalizadas apos parsing do CSV v1",
  "description": "Valida o envelope JSON apos parsing do CSV. Nao valida bytes CSV diretamente. Regras de codificacao, coluna e origem no caderno."
}
